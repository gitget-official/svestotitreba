{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Planiraj.API",
        "--launch-profile",
        "http"
      ],
      "port": 5080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "start"
      ],
      "port": 4200
    },
    {
      "name": "coming-soon",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server@14.1.1",
        "coming-soon/public",
        "-p",
        "8788",
        "-c-1",
        "--silent"
      ],
      "port": 8788
    }
  ]
}
